# ==========================================
# SkillCentral AI - Environment Variables
# ==========================================

# ------------------------------------------
# Google Gemini AI Model & API Key
# ------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------
# Google Tasks REST API & OAuth 2.0
# ------------------------------------------
# Setup Instructions:
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Enable "Google Tasks API" in APIs & Services -> Library
# 3. Create OAuth 2.0 Client ID (Application type: Web application)
# 4. Set Authorized redirect URI to: http://localhost:3000/api/integrations/google-tasks/callback
# 5. Paste Client ID and Client Secret below:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-tasks/callback

# ------------------------------------------
# Google Cloud Project & Firebase (Optional)
# ------------------------------------------
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ------------------------------------------
# Application Configuration
# ------------------------------------------
DEMO_MODE=false
